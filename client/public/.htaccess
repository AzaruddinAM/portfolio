# Hostinger (LiteSpeed/Apache) config for the Angular build
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS is forced by Hostinger's CDN (hPanel > Security > SSL > Force HTTPS)
  # Serve real files; send everything else to the SPA
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Hashed bundles can be cached forever; index.html and data must stay fresh
  <FilesMatch "\.[0-9a-zA-Z]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
